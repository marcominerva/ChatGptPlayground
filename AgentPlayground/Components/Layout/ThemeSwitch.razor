@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="theme-switch form-switch ps-0 d-flex align-items-center">
    <i class="bi bi-sun-fill" aria-hidden="true"></i>

    <input class="form-check-input" type="checkbox" role="switch" id="theme-switch"
           checked="@isDark" @onchange="OnSwitchChangedAsync" aria-label="Dark theme" />

    <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
</div>

@code {
    private DotNetObjectReference<ThemeSwitch>? reference;
    private IJSObjectReference? module;
    private bool isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/ThemeSwitch.razor.js");
        reference = DotNetObjectReference.Create(this);

        var theme = await module.InvokeAsync<string>("getCurrentTheme");
        isDark = theme == "dark";

        await module.InvokeVoidAsync("watchSystemTheme", reference);

        StateHasChanged();
    }

    /// <summary>
    /// Invoked from JavaScript when the operating system switches color scheme and no theme has been forced.
    /// </summary>
    /// <param name="theme">The theme applied by the system, either <c>light</c> or <c>dark</c>.</param>
    [JSInvokable]
    public void OnSystemThemeChanged(string theme)
    {
        isDark = theme == "dark";
        StateHasChanged();
    }

    private async Task OnSwitchChangedAsync(ChangeEventArgs args)
    {
        isDark = args.Value is true;

        if (module is not null)
        {
            await module.InvokeVoidAsync("setTheme", isDark ? "dark" : "light");
        }
    }

    public async ValueTask DisposeAsync()
    {
        reference?.Dispose();

        if (module is not null)
        {
            // The circuit may already be gone when the component is disposed.
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
