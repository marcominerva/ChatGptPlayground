<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<ResourcePreloader />
	<link rel="stylesheet" href="@Assets["lib/bootstrap/css/bootstrap.min.css"]" />
	<link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
	<link rel="stylesheet" href="@Assets["css/app.css"]" />
	<link rel="stylesheet" href="@Assets["AgentPlayground.styles.css"]" />
	<ImportMap />
	<link rel="icon" type="image/svg+xml" href="favicon.svg" />
	<script>
		// Applied before the first paint to avoid a flash of the wrong color mode.
		(() => {
			const query = window.matchMedia("(prefers-color-scheme: dark)");

			// The theme stored by the user takes precedence over the system settings.
			const apply = () => document.documentElement.setAttribute("data-bs-theme",
				localStorage.getItem("theme") ?? (query.matches ? "dark" : "light"));

			apply();
			query.addEventListener("change", apply);
		})();
	</script>
	<HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
	<ReconnectModal />
	<script src="@Assets["lib/bootstrap/js/bootstrap.bundle.min.js"]"></script>
	<script src="@Assets["js/functions.js"]"></script>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>